#N canvas 500 150 500 400 12;
#X obj 50 40 notein;
#X obj 50 80 poly 8 1;
#X obj 50 120 pack f f;
#X text 150 120 <- Packs [Pitch Velocity];
#X obj 50 160 clone -s 1 my_synth 8;
#X text 210 160 <- Automatically manages 8 synth voices;
#X obj 50 220 dac~;
#X connect 0 0 1 0;
#X connect 0 1 1 1;
#X connect 1 1 2 0;
#X connect 1 2 2 1;
#X connect 2 0 4 0;
#X connect 4 0 6 0;
#X connect 4 1 6 1;